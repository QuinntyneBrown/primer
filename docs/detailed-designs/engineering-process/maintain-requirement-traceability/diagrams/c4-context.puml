@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context - Maintain requirement traceability

Person(contributor, "Contributor", "Writes a failing test before an implementation")
System(gate, "Traceability gate", "Asserts that requirements and tests agree in both directions")
System_Ext(ci, "Continuous integration", "Runs the gate on every pull request")
System_Ext(specs, "Requirement specification", "docs/specs L1 and L2 markdown")
System_Ext(testproject, "Integration test project", "Tests carrying trace comments")

Rel(contributor, specs, "Adds an acceptance criterion to")
Rel(contributor, testproject, "Adds a failing test to")
Rel(gate, specs, "Reads every requirement identifier from")
Rel(gate, testproject, "Reads every trace comment from")
Rel(ci, gate, "Runs on every pull request")
Rel(gate, contributor, "Reports uncovered and dangling identifiers to")
@enduml
