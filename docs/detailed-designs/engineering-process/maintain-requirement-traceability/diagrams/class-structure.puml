@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure - Maintain requirement traceability

class SpecCatalog {
  +LoadL1(path: string): IReadOnlyList<RequirementRecord>
  +LoadL2(path: string): IReadOnlyList<RequirementRecord>
}

class RequirementRecord {
  +Id: string
  +ParentId: string
  +Title: string
  +AcceptanceCriteria: IReadOnlyList<string>
}

class TraceCommentScanner {
  +Scan(testProjectPath: string): IReadOnlyDictionary<string, IReadOnlyList<string>>
}

class TraceabilityTests {
  +EveryL2IsReferencedByATest(): void
  +EveryReferencedIdentifierExists(): void
  +EveryL2NamesExactlyOneExistingL1(): void
  +EveryL1IsNamedByAtLeastOneL2(): void
}

class TemporaryRepository {
  +Path: string
  +Seed(files: IDictionary<string, string>): void
  +Dispose(): void
}

class NoAmbientStateAttribute {
  +Before(context: TestContext): void
  +After(context: TestContext): void
}

SpecCatalog --> RequirementRecord : produces
TraceabilityTests ..> SpecCatalog : reads requirements from
TraceabilityTests ..> TraceCommentScanner : reads references from
TemporaryRepository <.. NoAmbientStateAttribute : asserts isolation of
@enduml
