@startuml
title UML sequence behaviour - Enforce the rules on a change
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Contributor" as contributor
box "Frontend - Pull request" #E0F2FE
  participant "CI runner" as runner
end box
box "Backend - Primer build" #D1FADF
  participant "dotnet format" as format
  participant "C# compiler and analysers" as compiler
end box
box "Backend - Architecture tests" #ECFDF3
  participant "LayoutRules" as layout
  participant "OneFilePerCommandRules" as onefile
  participant "SliceIsolationTests" as slices
  participant "AbstractionAudit" as audit
end box
box "Backend - Infrastructure" #FFF4E5
  database "Primer repository" as repo
end box

contributor -> repo : Add a feature folder under src
repo -> runner : Trigger the pull-request build

runner -> format : Verify formatting
format -> repo : Compare against the editorconfig rules
alt Formatting matches
  format --> runner : Exit 0
else Formatting differs
  format --> runner : L2-041 failure naming the file
end

runner -> compiler : Build with warnings as errors
alt No analyser warning is raised
  compiler --> runner : Build succeeded
else Any analyser warning is raised
  compiler --> runner : L2-041 build failed
end

runner -> layout : Assert the project layout
layout -> repo : Inspect project locations
layout --> runner : L2-038 production under src, tests under tests

runner -> onefile : Assert one public command type per command file
onefile --> runner : L2-039 result, no shared registration table required

runner -> slices : Assert feature isolation
slices --> runner : L2-040 no cross-feature type reference

runner -> audit : Assert abstraction use
audit --> runner : No direct Console or File access from a handler

runner --> contributor : Report the specific rule that failed, or success
@enduml
