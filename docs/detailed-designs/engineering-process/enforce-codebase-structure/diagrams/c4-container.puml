@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Enforce codebase structure

Person(contributor, "Contributor", "Changes the codebase")

System_Boundary(build, "Primer build") {
  Container(props, "Directory.Build.props", "MSBuild properties", "Nullable enabled, warnings as errors")
  Container(editorconfig, ".editorconfig", "Formatting rules", "Verified by dotnet format")
  Container(archtests, "Architecture tests", "xUnit project", "Asserts layout, slice isolation, and abstraction use")
  Container(compiler, "C# compiler and analysers", "Roslyn", "Fails on any analyser warning")
}

System_Boundary(repo, "Primer repository") {
  ContainerDb(src, "src/", "Production projects", "One folder per vertical slice")
  ContainerDb(tests, "tests/", "Test projects", "Primer.IntegrationTests and the architecture tests")
}

Rel(contributor, src, "Adds a feature folder to")
Rel(props, compiler, "Configures")
Rel(compiler, src, "Compiles")
Rel(editorconfig, src, "Formats")
Rel(archtests, src, "Asserts the L2-038 layout and L2-040 isolation of")
Rel(archtests, tests, "Resides under")
@enduml
