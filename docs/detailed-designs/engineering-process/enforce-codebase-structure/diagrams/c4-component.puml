@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Enforce codebase structure

Container_Boundary(archtests, "Architecture tests") {
  Component(layout, "LayoutRules", "Assertions", "Production under src, tests under tests")
  Component(onefile, "OneFilePerCommandRules", "Assertions", "One public command type per command file")
  Component(slices, "SliceIsolationTests", "Assertions", "No cross-feature type reference")
  Component(audit, "AbstractionAudit", "Assertions", "No direct Console or File access from a handler")
}

Container_Boundary(exe, "primer executable") {
  Component(module, "ICommandModule", "Abstraction", "Implemented once per command file")
  Component(scan, "Assembly scan registration", "Composition", "Registers every module without a shared table")
}

Rel(layout, exe, "Asserts the project layout of")
Rel(onefile, module, "Asserts one implementation per file of")
Rel(slices, exe, "Asserts feature isolation within")
Rel(audit, exe, "Asserts abstraction use within")
Rel(scan, module, "Discovers every implementation of")
@enduml
