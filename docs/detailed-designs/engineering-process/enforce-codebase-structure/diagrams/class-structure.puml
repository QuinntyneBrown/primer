title Class structure - Enforce codebase structure

interface ICommandModule {
  +Build(): Command
}

class InitCommand {
  +Build(): Command
}
class CheckCommand {
  +Build(): Command
}
class McpCommand {
  +Build(): Command
}

class CommandModuleRegistration {
  +{static} AddCommandModules(services: IServiceCollection, assembly: Assembly): IServiceCollection
}

class ArchitectureTests {
  +ProductionProjectsResideUnderSrc(): void
  +TestProjectsResideUnderTests(): void
  +EachCommandFileDeclaresOneCommandType(): void
}

class SliceIsolationTests {
  +NoFeatureReferencesAnotherFeatureType(): void
  +DeletingAFeatureLeavesTheBuildSucceeding(): void
}

class AbstractionAudit {
  +NoHandlerCallsSystemConsole(): void
  +NoHandlerCallsSystemIoFile(): void
}

interface IPrimerConsole
interface IFileWriter

ICommandModule <|.. InitCommand
ICommandModule <|.. CheckCommand
ICommandModule <|.. McpCommand
CommandModuleRegistration ..> ICommandModule : discovers by assembly scan
ArchitectureTests ..> ICommandModule : asserts one per file
SliceIsolationTests ..> ICommandModule : asserts isolation of
AbstractionAudit ..> IPrimerConsole : asserts use of
AbstractionAudit ..> IFileWriter : asserts use of
@enduml
