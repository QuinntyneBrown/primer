@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Generate AGENTS.md

Container_Boundary(exe, "primer executable") {
  Component(generator, "AgentsFileGenerator", "IAgentsFileGenerator", "Builds the document from the repository context")
  Component(composer, "SectionComposer", "Composition", "Orders sections and drops the empty ones")
  Component(sections, "ISection set", "Strategy set", "One implementation per prescribed section")
  Component(boundaries, "BoundariesSection", "ISection", "Names the paths that are off limits")
  Component(grounding, "GroundingValidator", "Validator", "Drops any unverifiable path or bare command")
  Component(fence, "UntrustedContentFence", "Guard", "Fences and escapes repository-derived text")
  Component(budget, "LineBudget", "Validator", "Enforces the 150-line ceiling")
  Component(region, "ManagedRegion", "Renderer", "Delimits, versions, and hashes the generated block")
  Component(hash, "ContentHash", "Helper", "Hashes the analysis inputs")
  Component(nested, "NestedProjectPlanner", "Planner", "Plans one nested file per project directory")
  Component(file, "GeneratedFile", "Record", "Target path, content, and intended action")
}

Rel(generator, composer, "Composes the draft with")
Rel(composer, sections, "Renders")
Rel(sections, boundaries, "Includes")
Rel(sections, fence, "Passes repository-derived text through")
Rel(generator, grounding, "Validates the draft with")
Rel(generator, budget, "Trims the draft with")
Rel(generator, region, "Wraps the result in")
Rel(region, hash, "Records the hash from")
Rel(generator, nested, "Plans nested files with")
Rel(generator, file, "Produces")
@enduml
