@startuml
title UML sequence behaviour - Compose, validate, and emit AGENTS.md
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Developer" as dev
box "Frontend - Terminal session" #E0F2FE
  participant "Shell" as shell
end box
box "Backend - Primer CLI host" #D1FADF
  participant "InitCommandHandler" as handler
end box
box "Backend - Primer Application" #ECFDF3
  participant "AgentsFileGenerator" as generator
  participant "SectionComposer" as composer
  participant "UntrustedContentFence" as fence
  participant "GroundingValidator" as grounding
  participant "LineBudget" as budget
end box
box "Backend - Infrastructure" #FFF4E5
  participant "AtomicFileWriter" as writer
  database "Working tree" as tree
end box

dev -> shell : primer init
shell -> handler : Invoke with the RepositoryContext
handler -> generator : Generate the document

generator -> composer : Compose the ordered sections
loop For each prescribed section
  composer -> composer : Skip the section when L2-013 finds no content
  opt The section carries repository-derived text
    composer -> fence : Fence and escape the text
    fence --> composer : L2-048 labelled block, quoted as data
  end
end
composer --> generator : Draft document

generator -> grounding : Validate every path and command
grounding -> tree : Confirm each referenced path exists
tree --> grounding : Presence per path
grounding --> generator : Draft with L2-015 unverifiable lines dropped

generator -> budget : Apply the line ceiling
alt The draft exceeds 150 lines
  budget -> budget : Drop lower-priority content and add a pointer note
end
budget --> generator : L2-014 draft at or below the ceiling

generator --> handler : L2-018 GeneratedFile per target, plain Markdown

opt --recursive was supplied
  generator -> generator : Plan one L2-017 nested file per project directory
end

handler -> writer : Write the planned files
writer -> tree : Emit content
tree --> writer : Write result
writer --> handler : FileAction per path
handler --> shell : ExitCode.Success
shell --> dev : Report created, updated, and unchanged paths
@enduml
