@startuml
title UML sequence behaviour - Classify a description and emit AGENTS.md
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Developer" as dev
box "Frontend - Terminal session" #E0F2FE
  participant "Shell" as shell
end box
box "Backend - Primer CLI host" #D1FADF
  participant "InvocationPipeline" as pipeline
  participant "InitCommand" as init
end box
box "Backend - Primer Application" #ECFDF3
  participant "PromptSource" as source
  participant "KeywordPromptClassifier" as classifier
  participant "GreenfieldGenerator" as generator
  participant "UntrustedContentFence" as fence
  participant "ManagedRegion" as region
end box
box "Backend - Infrastructure" #FFF4E5
  participant "AtomicFileWriter" as writer
  database "Target directory" as tree
end box

dev -> shell : primer init --prompt "..."
shell -> pipeline : Invoke with the parsed options
pipeline -> pipeline : L2-063 skip repository discovery, root at the target path
pipeline -> init : Dispatch

init -> source : Resolve the description
alt Both --prompt and --prompt-file supplied
  source --> init : L2-063 usage error, exit 2
else The named file is absent or empty
  source --> init : L2-063 configuration error, exit 3
else One description resolves
  source --> init : PromptText
end

alt --archetype was supplied
  init -> init : L2-064 resolve the named archetype
else
  init -> classifier : Classify the description
  classifier -> classifier : Match the fixed signal table, offline
  alt The table settles nothing
    classifier --> init : L2-064 undecidable, exit 2 naming both archetypes
  else
    classifier --> init : SolutionArchetype
  end
end

init -> generator : Generate for the chosen archetype
generator -> generator : Locate the archetype template
generator -> fence : Quote the description
fence --> generator : L2-068 labelled block with delimiters escaped
generator -> generator : L2-068 hold the body within the 150-line ceiling
generator -> region : Wrap with version and input hash
region --> generator : L2-068 single managed region
generator --> init : GeneratedFile

init -> writer : Write AGENTS.md and the pointer files
writer -> tree : Emit content
tree --> writer : Write result
writer --> init : FileAction per path
init --> shell : ExitCode.Success
shell --> dev : Report created, updated, and unchanged paths
@enduml
