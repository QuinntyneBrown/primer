@startuml
title UML sequence behaviour - Resolve, validate, and dispatch
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Developer" as dev
box "Frontend - Terminal session" #E0F2FE
  participant "Shell" as shell
end box
box "Backend - Primer CLI host" #D1FADF
  participant "PrimerHostBuilder" as host
  participant "ConfigurationSourceOrder" as order
  participant "PrimerOptionsValidator" as validator
end box
box "Backend - Primer Application" #ECFDF3
  participant "PrimerOptions" as options
  participant "Command handler" as handler
end box
box "Backend - Infrastructure" #FFF4E5
  database "primer.json" as file
  database "PRIMER_ variables" as env
end box

dev -> shell : primer init --verbosity detailed
shell -> host : Start and build the host
host -> order : Apply the L2-034 precedence order
order -> file : Read repository settings
file --> order : Values below the environment
order -> env : Read PRIMER_ variables
env --> order : Values below the command line
order -> options : Bind the merged configuration
options --> order : Bound options root
order --> host : Configuration complete

host -> validator : Validate before any file access
alt Every constraint holds
  validator --> host : Success
  host -> handler : Resolve from the container and invoke
  note right of handler
    L2-036 validates the container at
    startup, so resolution cannot fail
    with an unresolvable dependency.
  end note
  handler --> host : ExitCode
else A constraint is violated
  validator --> host : Failure naming the L2-035 offending key
  host --> shell : ExitCode.Configuration
  note right of validator
    No file has been read or written
    at this point.
  end note
end

host --> shell : Process exit code
shell --> dev : Present the result
@enduml
